{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatwoodlabs.com/schemas/pvs-manifest-v1.schema.json",
  "title": "Physics Validation Suite package manifest envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package", "integrity"],
  "properties": {
    "schema": {"const": "pvs-manifest/1"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "created_at", "files"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^pvs:sha256:[0-9a-f]{64}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role", "sha256", "size_bytes"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "role": {"enum": ["case", "evidence", "report", "log", "artifact"]},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "algorithm", "digest", "package_id"],
      "properties": {
        "canonicalization": {"const": "RFC8785"},
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "package_id": {"type": "string", "pattern": "^pvs-package:sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
