{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["injected", "deposited", "lost", "temperature", "fraction"],
  "properties": {
    "injected": {"type": "number"},
    "deposited": {"type": "number"},
    "lost": {"type": "number"},
    "temperature": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "number"}
    },
    "fraction": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    }
  }
}

