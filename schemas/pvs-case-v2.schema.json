{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatwoodlabs.com/schemas/pvs-case-v2.schema.json",
  "title": "Physics Validation Suite case v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "title", "classifications", "subject", "artifacts", "checks"],
  "properties": {
    "schema": {"const": "pvs-case/2"},
    "id": {"type": "string", "pattern": "^(?![\\s\\S]*[\\r\\n\\u2028\\u2029])[a-z0-9][a-z0-9._-]{1,127}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "description": {"type": "string", "maxLength": 4000},
    "classifications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["verification", "validation", "regression", "cross-code-comparison"]
      }
    },
    "subject": {"$ref": "#/$defs/subject"},
    "execution": {"$ref": "#/$defs/execution"},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(?![\\s\\S]*[\\r\\n\\u2028\\u2029])[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reference"}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "package": {"$ref": "#/$defs/package"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "revision": {"type": "string", "maxLength": 200},
        "source_repository": {"type": "string", "format": "uri"},
        "description": {"type": "string", "maxLength": 2000}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "prefixItems": [{"type": "string", "minLength": 1, "maxLength": 8192}],
          "items": {"type": "string", "maxLength": 8192}
        },
        "working_directory": {"type": "string", "minLength": 1, "default": "."},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 604800},
        "environment": {
          "type": "object",
          "propertyNames": {"pattern": "^(?![\\s\\S]*[\\r\\n\\u2028\\u2029])[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"type": "string"}
        },
        "expected_exit_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 255},
          "default": [0]
        },
        "random_seed": {"type": ["integer", "string", "null"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "role": {"enum": ["subject", "input", "reference", "output", "auxiliary"]},
        "format": {"enum": ["json", "csv", "netcdf", "text", "binary"]},
        "required": {"type": "boolean", "default": true},
        "expected_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^(?![\\s\\S]*[\\r\\n\\u2028\\u2029])[0-9a-f]{64}$"},
        "media_type": {"type": "string", "maxLength": 200},
        "description": {"type": "string", "maxLength": 2000}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "citation", "locator"],
      "properties": {
        "id": {"type": "string", "pattern": "^(?![\\s\\S]*[\\r\\n\\u2028\\u2029])[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
        "type": {"enum": ["analytic", "published", "experimental", "canonical-fixture", "cross-code"]},
        "citation": {"type": "string", "minLength": 1, "maxLength": 4000},
        "locator": {"type": "string", "minLength": 1, "maxLength": 4000},
        "artifact": {"type": "string"},
        "source_location": {"type": "string", "maxLength": 1000},
        "accessed_utc": {"type": "string", "format": "date"},
        "derivation": {"type": "string", "maxLength": 4000},
        "notes": {"type": "string", "maxLength": 4000}
      }
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![\\s\\S]*[\\r\\n\\t\\u2028\\u2029])\\S(?:[\\s\\S]*\\S)?$"
    },
    "sourceCore": {
      "type": "object",
      "required": ["artifact", "unit"],
      "properties": {
        "artifact": {"type": "string"},
        "unit": {"$ref": "#/$defs/unit"},
        "component": {"type": "integer", "minimum": 0},
        "reduce": {"enum": ["sum", "mean", "min", "max", "first", "last", "size"]}
      },
      "allOf": [
        {
          "if": {"required": ["reduce"], "properties": {"reduce": {"const": "size"}}},
          "then": {"properties": {"unit": {"const": "1"}}}
        }
      ]
    },
    "sourceRoot": {
      "allOf": [{"$ref": "#/$defs/sourceCore"}],
      "unevaluatedProperties": false
    },
    "sourceJson": {
      "allOf": [
        {"$ref": "#/$defs/sourceCore"},
        {
          "type": "object",
          "required": ["pointer"],
          "properties": {"pointer": {"type": "string"}}
        }
      ],
      "unevaluatedProperties": false
    },
    "sourceCsv": {
      "allOf": [
        {"$ref": "#/$defs/sourceCore"},
        {
          "type": "object",
          "required": ["column"],
          "properties": {"column": {"type": "string"}}
        }
      ],
      "unevaluatedProperties": false
    },
    "sourceNetcdf": {
      "allOf": [
        {"$ref": "#/$defs/sourceCore"},
        {
          "type": "object",
          "required": ["variable", "netcdf_decoding"],
          "properties": {
            "variable": {"type": "string", "minLength": 1},
            "netcdf_decoding": {"const": "pvs-netcdf/1"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "source": {
      "oneOf": [
        {"$ref": "#/$defs/sourceRoot"},
        {"$ref": "#/$defs/sourceJson"},
        {"$ref": "#/$defs/sourceCsv"},
        {"$ref": "#/$defs/sourceNetcdf"}
      ]
    },
    "literalOperand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {
          "oneOf": [
            {"type": "number"},
            {
              "type": "array",
              "minItems": 1,
              "items": {"type": "number"}
            }
          ]
        },
        "unit": {"$ref": "#/$defs/unit"}
      }
    },
    "operand": {
      "oneOf": [
        {"$ref": "#/$defs/source"},
        {"$ref": "#/$defs/literalOperand"}
      ]
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "coefficient"],
      "properties": {
        "value": {"$ref": "#/$defs/operand"},
        "coefficient": {"type": "number"},
        "label": {"type": "string", "maxLength": 200}
      }
    },
    "checkCommon": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "pattern": "^(?![\\s\\S]*[\\r\\n\\u2028\\u2029])[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
        "type": {"enum": ["exists", "schema", "finite", "range", "monotonic", "compare", "reference", "conservation"]},
        "description": {"type": "string", "maxLength": 2000},
        "required": {"type": "boolean", "default": true}
      }
    },
    "numericSourceCheck": {
      "type": "object",
      "required": ["source", "unit"],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "unit": {"$ref": "#/$defs/unit"}
      }
    },
    "comparisonCore": {
      "type": "object",
      "required": ["actual", "expected", "metric", "unit"],
      "properties": {
        "actual": {"$ref": "#/$defs/operand"},
        "expected": {"$ref": "#/$defs/operand"},
        "metric": {"enum": ["absolute", "relative", "l1", "l2", "linf", "close"]},
        "unit": {"$ref": "#/$defs/unit"}
      }
    },
    "metricAbsolute": {
      "type": "object",
      "required": ["tolerance"],
      "properties": {
        "metric": {"const": "absolute"},
        "tolerance": {"type": "number", "minimum": 0}
      }
    },
    "metricRelative": {
      "type": "object",
      "required": ["tolerance", "scale_floor"],
      "properties": {
        "metric": {"const": "relative"},
        "tolerance": {"type": "number", "minimum": 0},
        "scale_floor": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "metricL1": {
      "type": "object",
      "required": ["tolerance"],
      "properties": {
        "metric": {"const": "l1"},
        "tolerance": {"type": "number", "minimum": 0}
      }
    },
    "metricL2": {
      "type": "object",
      "required": ["tolerance"],
      "properties": {
        "metric": {"const": "l2"},
        "tolerance": {"type": "number", "minimum": 0}
      }
    },
    "metricLinf": {
      "type": "object",
      "required": ["tolerance"],
      "properties": {
        "metric": {"const": "linf"},
        "tolerance": {"type": "number", "minimum": 0}
      }
    },
    "metricClose": {
      "type": "object",
      "required": ["absolute_tolerance", "relative_tolerance"],
      "properties": {
        "metric": {"const": "close"},
        "absolute_tolerance": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0}
      }
    },
    "metric": {
      "oneOf": [
        {"$ref": "#/$defs/metricAbsolute"},
        {"$ref": "#/$defs/metricRelative"},
        {"$ref": "#/$defs/metricL1"},
        {"$ref": "#/$defs/metricL2"},
        {"$ref": "#/$defs/metricLinf"},
        {"$ref": "#/$defs/metricClose"}
      ]
    },
    "checkExists": {
      "allOf": [
        {"$ref": "#/$defs/checkCommon"},
        {
          "type": "object",
          "required": ["artifact"],
          "properties": {
            "type": {"const": "exists"},
            "artifact": {"type": "string"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "checkSchema": {
      "allOf": [
        {"$ref": "#/$defs/checkCommon"},
        {
          "type": "object",
          "required": ["artifact", "schema_artifact"],
          "properties": {
            "type": {"const": "schema"},
            "artifact": {"type": "string"},
            "schema_artifact": {"type": "string"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "checkFinite": {
      "allOf": [
        {"$ref": "#/$defs/checkCommon"},
        {"$ref": "#/$defs/numericSourceCheck"},
        {"type": "object", "properties": {"type": {"const": "finite"}}}
      ],
      "unevaluatedProperties": false
    },
    "checkRange": {
      "allOf": [
        {"$ref": "#/$defs/checkCommon"},
        {"$ref": "#/$defs/numericSourceCheck"},
        {
          "type": "object",
          "properties": {
            "type": {"const": "range"},
            "minimum": {"type": "number"},
            "maximum": {"type": "number"},
            "inclusive_minimum": {"type": "boolean", "default": true},
            "inclusive_maximum": {"type": "boolean", "default": true}
          },
          "anyOf": [{"required": ["minimum"]}, {"required": ["maximum"]}]
        }
      ],
      "unevaluatedProperties": false
    },
    "checkMonotonic": {
      "allOf": [
        {"$ref": "#/$defs/checkCommon"},
        {"$ref": "#/$defs/numericSourceCheck"},
        {
          "type": "object",
          "required": ["direction", "absolute_tolerance"],
          "properties": {
            "type": {"const": "monotonic"},
            "direction": {"enum": ["increasing", "decreasing", "nondecreasing", "nonincreasing"]},
            "absolute_tolerance": {"type": "number", "minimum": 0}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "checkCompare": {
      "allOf": [
        {"$ref": "#/$defs/checkCommon"},
        {"$ref": "#/$defs/comparisonCore"},
        {"type": "object", "properties": {"type": {"const": "compare"}}},
        {"$ref": "#/$defs/metric"}
      ],
      "unevaluatedProperties": false
    },
    "checkReference": {
      "allOf": [
        {"$ref": "#/$defs/checkCommon"},
        {"$ref": "#/$defs/comparisonCore"},
        {
          "type": "object",
          "required": ["reference_id"],
          "properties": {
            "type": {"const": "reference"},
            "reference_id": {"type": "string"}
          }
        },
        {"$ref": "#/$defs/metric"}
      ],
      "unevaluatedProperties": false
    },
    "checkConservation": {
      "allOf": [
        {"$ref": "#/$defs/checkCommon"},
        {
          "type": "object",
          "required": ["terms", "expected", "absolute_tolerance", "relative_tolerance", "unit"],
          "properties": {
            "type": {"const": "conservation"},
            "terms": {
              "type": "array",
              "minItems": 2,
              "items": {"$ref": "#/$defs/term"}
            },
            "expected": {"$ref": "#/$defs/operand"},
            "normalization": {"$ref": "#/$defs/operand"},
            "absolute_tolerance": {"type": "number", "minimum": 0},
            "relative_tolerance": {"type": "number", "minimum": 0},
            "unit": {"$ref": "#/$defs/unit"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "check": {
      "oneOf": [
        {"$ref": "#/$defs/checkExists"},
        {"$ref": "#/$defs/checkSchema"},
        {"$ref": "#/$defs/checkFinite"},
        {"$ref": "#/$defs/checkRange"},
        {"$ref": "#/$defs/checkMonotonic"},
        {"$ref": "#/$defs/checkCompare"},
        {"$ref": "#/$defs/checkReference"},
        {"$ref": "#/$defs/checkConservation"}
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "embed_artifacts": {"type": "boolean", "default": false},
        "html": {"type": "boolean", "default": true},
        "pdf": {"type": "boolean", "default": true}
      }
    }
  }
}
